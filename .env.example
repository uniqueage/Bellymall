# Public site origin used for canonical URLs, OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://bellymall-ng.vercel.app

# Optional Supabase backend (the storefront works fully without it).
# Add the same two variables in Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
